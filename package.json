{
  "name": "textboxhelper",
  "version": "0.2.2",
  "nextVersion": "0.3.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "marks": "node scripts/marks.mjs",
    "cheatsheet": "node scripts/cheatsheet.mjs",
    "gen": "node scripts/version.mjs && node scripts/gen-mark-images.mjs",
    "postinstall": "npm run gen",
    "next-version": "node scripts/version.mjs --set-next",
    "test-notes": "node scripts/test-notes.mjs --out build/TESTING.md",
    "test:scripts": "node scripts/test-marks.mjs && node scripts/test-versioning.mjs && node scripts/test-ci-build.mjs && node scripts/test-test-notes.mjs",
    "check": "npm run gen && node scripts/marks.mjs --check && node scripts/cheatsheet.mjs --check && npm run test:scripts && tsc --noEmit && eslint . --max-warnings 0 && jest --passWithNoTests"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-fs": "^2.20.0",
    "sn-plugin-lib": "0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "opentype.js": "^2.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Textbox Tools is an experimental Supernote NOTE plugin for structured text editing inside notes.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilmanbergt/textboxHelper.git"
  },
  "keywords": [],
  "author": "Tilman Bergt",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tilmanbergt/textboxHelper/issues"
  },
  "homepage": "https://github.com/tilmanbergt/textboxHelper#readme"
}
